# ==============================================================================
# GitHub Automation Bot - Backend Environment Variables Template
# ==============================================================================

PORT=3001
NODE_ENV=development

# Database Connection (Supabase / Neon PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Session Secret (Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SESSION_SECRET=your_cryptographic_random_session_secret_at_least_32_chars

# GitHub OAuth App Credentials
# Create at https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: https://[YOUR-RENDER-APP-URL]/api/auth/callback (or http://localhost:3001/api/auth/callback for local)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/callback

# Public URL of this Backend (used when auto-registering webhooks on GitHub)
BACKEND_PUBLIC_URL=http://localhost:3001

# Slack Incoming Webhook (Optional for notifications)
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url_here

# Gemini AI API Key (Free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application URL (for CORS & post-auth redirects)
FRONTEND_URL=http://localhost:5173
