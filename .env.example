# ==============================================================================
# Root Environment Variables Template - GitHub Automation Bot
# ==============================================================================

# Backend Configuration (Deploy on Render)
PORT=3001
NODE_ENV=production
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SESSION_SECRET=create_a_strong_random_secret_at_least_32_chars
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=https://your-backend.onrender.com/api/auth/callback
BACKEND_PUBLIC_URL=https://your-backend.onrender.com
FRONTEND_URL=https://your-frontend.vercel.app

# Slack Notification Webhook (Optional)
SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url_here

# Google Gemini AI API Key (Optional Stretch Goal - https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
